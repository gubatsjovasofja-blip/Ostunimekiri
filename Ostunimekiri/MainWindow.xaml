<Window x:Class="Ostunimekiri.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ostunimekiri" Height="350" Width="500"
        Background="#F3F6F0">

    <StackPanel VerticalAlignment="Center">

        <TextBlock Text="Ostunimekiri"
                   FontSize="30"
                   Foreground="#344D38"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <TextBlock Text="Planeeri oma oste ja halda toiduvarusid"
                   HorizontalAlignment="Center"
                   Foreground="#657768"
                   Margin="0,0,0,20"/>

        <Button Content="Kodused varud"
                Width="240" Height="40"
                Background="#DCE8D9"
                Foreground="#344D38"
                Margin="5"
                Click="OpenStock_Click"/>

        <Button Content="Ostunimekiri"
                Width="240" Height="40"
                Background="#DCE8D9"
                Foreground="#344D38"
                Margin="5"/>

        <TextBlock Text="Sofja Gubatšjova ja Azhar Ryskhan"
                   FontSize="12"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   Margin="0,25,0,0"/>

    </StackPanel>
</Window>