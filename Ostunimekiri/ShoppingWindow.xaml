<Window x:Class="Ostunimekiri.ShoppingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ostunimekiri" Height="500" Width="600">

    <StackPanel Margin="30">

        <TextBlock Text="Ostunimekiri"
                   FontSize="26"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <TextBlock Text="Toote nimi"/>

        <TextBox x:Name="ProductTextBox"
                 Height="30"
                 Margin="0,5,0,10"/>

        <Button x:Name="AddButton"
                Content="Lisa toode"
                Height="30"
                Margin="0,0,0,10"
                Click="AddButton_Click"/>

        <ListBox x:Name="ShoppingListBox"
                 Height="130"
                 Margin="0,0,0,10"/>

        <Button x:Name="MarkButton"
                Content="Märgi ostetuks"
                Height="30"
                Margin="0,0,0,5"
                Click="MarkButton_Click"/>

        <Button x:Name="DeleteButton"
                Content="Kustuta toode"
                Height="30"
                Margin="0,0,0,5"
                Click="DeleteButton_Click"/>

        <Button x:Name="BackButton"
                Content="Tagasi"
                Height="30"/>

    </StackPanel>

</Window>