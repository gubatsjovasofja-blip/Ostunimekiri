<Window x:Class="Ostunimekiri.ShoppingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ostunimekiri"
        Height="500" Width="600"
        Background="#F3F6F0"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="30">

        <TextBlock Text="Ostunimekiri"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#344D38"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <TextBlock Text="Toote nimi"
                   Foreground="#344D38"/>

        <TextBox x:Name="ProductTextBox"
                 Foreground="#344D38"
                 Height="30"
                 Margin="0,5,0,10"/>

        <Button x:Name="AddButton"
                Content="Lisa toode"
                Background="#DCE8D9"
                Foreground="#344D38"
                Height="30"
                Margin="0,0,0,10"
                Click="AddButton_Click"/>

        <ListBox x:Name="ShoppingListBox"
                 Foreground="#344D38"
                 Height="130"
                 Margin="0,0,0,10"/>

        <Button x:Name="MarkButton"
                Content="Märgi ostetuks"
                Background="#DCE8D9"
                Foreground="#344D38"
                Height="30"
                Margin="0,0,0,5"
                Click="MarkButton_Click"/>

        <Button x:Name="DeleteButton"
                Content="Kustuta toode"
                Background="#EBDDD9"
                Foreground="#784D42"
                Height="30"
                Margin="0,0,0,5"
                Click="DeleteButton_Click"/>

        <Button x:Name="BackButton"
                Content="Tagasi"
                Background="#E5E5E5"
                Foreground="#344D38"
                Height="30"
                Click="BackButton_Click"/>

    </StackPanel>

</Window>